pre_upgrade() {
    local old=/etc/antec-flux-pro-daemon/config.toml
    local new=/etc/fluxprod.toml

    if [[ $2 == 0.1.0-1 && -f $old && ! -e $new && ! -L $new ]]; then
        cp --update=none --preserve=mode,ownership -- "$old" "$new"
    fi
}

pre_remove() {
    if [[ -d /run/systemd/system ]]; then
        systemctl disable --now antec-flux-pro-daemon.service
    fi
}
